<mxfile host="drawio"><diagram name="P2 disk full"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="AWS Cloud" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fontColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontStyle=1;container=0;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1260" height="640" as="geometry"/></mxCell><mxCell id="n2" value="VPC: public subnet" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fontColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontStyle=1;container=0;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="700" height="580" as="geometry"/></mxCell><mxCell id="n3" value="Clients" style="shape=mxgraph.aws4.users;fillColor=#232F3E;strokeColor=none;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="48" height="48" as="geometry"/></mxCell><mxCell id="n4" value="EC2: Ubuntu 24.04,&lt;br&gt;NGINX load balancer" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="n5" value="Upstream app servers" style="shape=mxgraph.aws4.instance2;fillColor=#ED7100;strokeColor=none;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="48" height="48" as="geometry"/></mxCell><mxCell id="n6" value="EBS gp3 root volume: 64 GB, 99% used" style="shape=mxgraph.aws4.volume;fillColor=#7AA116;strokeColor=none;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="236" y="260" width="44" height="44" as="geometry"/></mxCell><mxCell id="n7" value="What usually fills it, biggest suspects first:&lt;br&gt;1. /var/log/nginx: access logs not rotated&lt;br&gt;2. Deleted log files NGINX still holds open&lt;br&gt;3. /var/cache/nginx: proxy_cache without max_size&lt;br&gt;4. /var/lib/nginx: proxy and client-body temp files&lt;br&gt;5. /var/log/journal, syslog: debug or error floods&lt;br&gt;6. /var/crash, core dumps; snap and apt caches, old kernels" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="660" height="150" as="geometry"/></mxCell><mxCell id="n8" value="Also check inode exhaustion (df -i): millions of small cache files fill inodes before bytes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="660" height="40" as="geometry"/></mxCell><mxCell id="n9" value="CloudWatch agent on the instance: disk_used_percent, inode usage, log shipping" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="290" height="50" as="geometry"/></mxCell><mxCell id="n10" value="Monitoring and response" style="rounded=1;arcSize=4;strokeColor=#879196;dashed=1;fontColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="480" height="580" as="geometry"/></mxCell><mxCell id="n11" value="CloudWatch metrics:&lt;br&gt;disk_used_percent" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="840" y="120" width="56" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Alarms: 70% warn, 85% page,&lt;br&gt;forecast full within 24 h" style="shape=mxgraph.aws4.alarm;fillColor=#E7157B;strokeColor=none;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="48" height="48" as="geometry"/></mxCell><mxCell id="n13" value="SNS: Slack + on-call" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="56" height="56" as="geometry"/></mxCell><mxCell id="n14" value="CloudWatch Logs: NGINX logs&lt;br&gt;kept here, not on disk" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="56" height="56" as="geometry"/></mxCell><mxCell id="n15" value="Systems Manager: cleanup&lt;br&gt;runbook, no SSH needed" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="840" y="480" width="56" height="56" as="geometry"/></mxCell><mxCell id="n16" value="EBS: online resize if the&lt;br&gt;growth is legitimate" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_block_store;fillColor=#7AA116;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bott